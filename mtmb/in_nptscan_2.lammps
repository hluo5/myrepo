echo both
variable    T equal 2000.0   # temperature in K
variable    P1 equal 10000
variable    P2 equal 600000

variable    dt equal 0.001  # ps
variable    freq equal 400
variable    NSWeq equal 200000  # equil run step
variable    NSWin equal 4000  # equil run step

# calculate fparam for deepmd potential
variable    kBeV equal 8.617333262e-5    # eV/K, Boltzmann
variable    TeV equal  ${T}*${kBeV}

# convert from LAMMPS metal units to SI
variable    kB equal 1.3806504e-23       # [J/K] Boltzmann
variable    ev2j equal 1.60218e-19
variable    A2m equal 1.0e-10
variable    ps2s equal 1.0e-12


units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check no

read_data       conf.lmp
mass             1 24.305
mass             2 28.085
mass             3 16.000
mass             4  4.000

pair_style      deepmd ../../MLP_used/m12v3.comp.pb fparam ${TeV}
pair_coeff * * Mg Si O H

velocity        all create ${T} 23456789
fix             2 all npt temp ${T} ${T} 0.04 iso ${P1} ${P1} 0.4
timestep        ${dt}
thermo          ${freq}
thermo_style    custom step pe ke etotal temp press vol pxx pyy pzz pxy pyz pxz
run             ${NSWin}
unfix           2


velocity        all create ${T} 23456789
fix             1 all npt temp ${T} ${T} 0.04 iso ${P1} ${P2} 0.4
timestep        ${dt}
thermo          ${freq}
thermo_style    custom step pe ke etotal temp press vol pxx pyy pzz pxy pyz pxz
dump            2 all custom ${freq} npt.dump id type x y z
run             ${NSWeq}
unfix           1

velocity        all create ${T} 23456789
fix             1 all npt temp ${T} ${T} 0.04 iso ${P2} ${P1} 0.4
timestep        ${dt}
thermo          ${freq}
thermo_style    custom step pe ke etotal temp press vol pxx pyy pzz pxy pyz pxz
run             ${NSWeq}
unfix           1
