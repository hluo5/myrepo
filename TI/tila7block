#/bin/bash
  
grep 'F' OSZICAR | cut -c 37-51 > e.txt

i=2000

cat << EOF > block.py
#!/usr/bin/python
import numpy as np
import pandas as pd
import pyblock

data = np.loadtxt("e.txt",skiprows=$i,max_rows=None)
data = pd.Series(data)
(data_length, reblock_data, covariance) = pyblock.pd_utils.reblock(data)
data = pyblock.pd_utils.reblock_summary(reblock_data)
data.to_csv('./e_tiblock.csv',sep = '\t')

EOF

chmod 755 block.py

python block.py

rm block.py
