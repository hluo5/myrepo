#/bin/bash

i=500

cat << EOF > block.py
#!/usr/bin/python
import numpy as np
import pandas as pd
import pyblock

data = np.loadtxt("F_diff",skiprows=$i,max_rows=None)
data = pd.Series(data)
(data_length, reblock_data, covariance) = pyblock.pd_utils.reblock(data)
data = pyblock.pd_utils.reblock_summary(reblock_data)
data.to_csv('./F_diff_block.csv',sep = '\t')

EOF

chmod 755 block.py

python block.py

rm block.py
