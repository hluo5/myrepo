######################################################################
#                                                                    #
#   2 phase Simulation for PbO2-type SiO2 melting along B axis       #
#                                                                    #
#    1. Construct supercell                                          #
#    2. NPT simulation at target PT condition                        #
#    3. half NVT simulation at high T to ensure melting              #
#    4. NPT simulation to relax                                      #
#    5. 2 phase NPT simulation                                       #
#                                                                    #
######################################################################

variable        TEMP            equal 6290.000
variable        PRES            equal 1400000.000

variable        NSTEPS_relax1   equal 10000
variable        NSTEPS_melt     equal 5000
variable        NSTEPS_relax2   equal 1000
variable        NSTEPS_sample   equal 1000000
variable        TEMP_MELT       equal 10000.000

variable        THERMO_prepFREQ equal 10
variable        DUMP_prepFREQ   equal 10
variable        THERMO_FREQ     equal 50
variable        DUMP_FREQ       equal 50
variable        TIMESTEP        equal 0.001

variable        TAU_T           equal 0.0500000         # 0.1 ps standard value
variable        TAU_P           equal 0.500000          # This is 10 ps

# calculate fparam for deepmd potential
variable        kBeV            equal 8.617333262e-5    # eV/K, Boltzmann
variable        TeV             equal ${TEMP}*${kBeV}

units           metal
boundary        p p p
atom_style      atomic
timestep        ${TIMESTEP}
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check no

##### atom position #####
read_data       PbO2.pos
mass            1 28.090
mass            2 16.000

##### potential #####
pair_style      deepmd MLP.pb fparam ${TeV}
pair_coeff      * *

replicate       6 10 6

##### preparation for 2 phase simulation #####
thermo          ${THERMO_prepFREQ}
thermo_style    custom step temp press vol lx ly lz etotal
dump            PREP all atom ${DUMP_FREQ} PREP1.out

# NPT simulation at target PT condition
velocity        all create ${TEMP} 491001 mom yes rot yes dist gaussian
fix             RELAX all npt temp ${TEMP} ${TEMP} ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}
run             ${NSTEPS_relax1}
unfix           RELAX
write_data      PbO2.mid.pos

